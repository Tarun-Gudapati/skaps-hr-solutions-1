# Copy to .env.local (or set as GitHub repository variables) to send leads to a form service.
# Formspree: VITE_LEAD_ENDPOINT=https://formspree.io/f/<form-id>
# Web3Forms: VITE_LEAD_ENDPOINT=https://api.web3forms.com/submit and VITE_LEAD_ACCESS_KEY=<access-key>
# When unset, the forms open the visitor's email app pre-filled to info@skaps.co.in.
VITE_LEAD_ENDPOINT=
VITE_LEAD_ACCESS_KEY=
